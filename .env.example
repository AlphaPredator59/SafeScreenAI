# Application
APP_NAME=SafeScreen AI
APP_ENV=development
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/safescreen

# Storage
STORAGE_PATH=storage
MAX_UPLOAD_SIZE_BYTES=524288000
MAX_VIDEO_DURATION_SECONDS=1800
FRAME_SAMPLING_INTERVAL_SECONDS=1.0
FRAME_IMAGE_FORMAT=jpg
FRAME_IMAGE_QUALITY=85
AUDIO_OUTPUT_FORMAT=wav
 
# AI Model Configuration
AI_MODE=mock
AI_DEVICE=cpu
VISION_MODEL_NAME=yolov8n.pt
VISION_CONFIDENCE_THRESHOLD=0.25
TRANSCRIPTION_MODEL_NAME=tiny
TRANSCRIPTION_LANGUAGE=
TEXT_MODERATION_MODEL_NAME=unitary/toxic-bert
TEXT_MODERATION_CONFIDENCE_THRESHOLD=0.5
CONTEXT_MODEL_NAME=qwen2.5vl:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
CONTEXT_TIMEOUT_SECONDS=120.0

# Postgres Database
DATABASE_URL=postgresql+psycopg://postgres:Altdemon@29@localhost:5432/safescreen

# Moderation Engine Configuration
MODERATION_LOW_RISK_THRESHOLD=0.30
MODERATION_MEDIUM_RISK_THRESHOLD=0.60
MODERATION_HIGH_RISK_THRESHOLD=0.85
MODERATION_AUTO_REJECT_THRESHOLD=0.85
MODERATION_REVIEW_THRESHOLD=0.40
MODERATION_MIN_SIGNAL_CONFIDENCE=0.30